# ─────────────────────────────────────────────────────────────
# HARA Ceylon — Backend Production Environment (Hostinger)
# Upload this file as .env to api.haraceylon.com server root
# ─────────────────────────────────────────────────────────────

# Database — use the absolute path on Hostinger
DATABASE_URL="file:/home/u123456789/domains/api.haraceylon.com/public_html/prisma/prod.db"

# JWT Secrets — keep these EXACTLY the same as your current secrets
JWT_ACCESS_SECRET="14e2f50625feb8a4624713611880324a2b40b86f62f8c6ed395f686c91e73888"
JWT_REFRESH_SECRET="3bb50cf6b964adb5b873a0a64984a29e72be5ff9552ee2fa9e16b19d6175538b"

# Server port (Hostinger Node.js manager may override this)
PORT=8001

# Google OAuth
GOOGLE_CLIENT_ID="98175345028-thqhop2gkrs1b7i0hjrak382u071n5nh.apps.googleusercontent.com"

# ── CRITICAL: Production-only settings ────────────────────────
# The public URL of THIS backend — used to build absolute image URLs
BACKEND_URL="https://api.haraceylon.com"

# Allowed frontend origins — MUST match exactly (no trailing slash)
CORS_ORIGINS="https://haraceylon.com,https://www.haraceylon.com"

NODE_ENV="production"
